{
  "name": "lf-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente da L&F no WhatsApp — resumo diário da operação, conversa e PDF sob demanda",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "preview": "tsx test/preview.ts",
    "digest": "tsx --env-file-if-exists=.env src/cli/digest.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx --env-file-if-exists=.env mcp/loja-server.ts",
    "diagnostico": "tsx --env-file-if-exists=.env src/cli/diagnostico.ts",
    "google-oauth": "tsx --env-file-if-exists=.env src/cli/google-oauth.ts",
    "google-teste": "tsx --env-file-if-exists=.env src/cli/google-teste.ts",
    "tempos": "tsx --env-file-if-exists=.env src/cli/tempos.ts",
    "whatsapp-teste": "tsx --env-file-if-exists=.env src/cli/whatsapp-teste.ts",
    "troque-teste": "tsx --env-file-if-exists=.env src/cli/troque-teste.ts",
    "boletim": "tsx --env-file-if-exists=.env src/cli/boletim.ts",
    "conferir-estorno": "tsx --env-file-if-exists=.env src/cli/conferir-estorno.ts",
    "conferir-estorno-pdf": "tsx --env-file-if-exists=.env src/cli/conferir-estorno-pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
