# ---------------------------------------------------------------------------
# WhatsApp (Evolution API)
# ---------------------------------------------------------------------------
# URL do serviço da Evolution. No Railway é o domínio público do serviço.
EVOLUTION_URL=https://evolution-production-xxxx.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=lf
# Quem RECEBE o resumo e pode conversar com o assistente — os telefones pessoais,
# não o chip do bot. O chip dedicado é o número que a Evolution conecta pelo QR;
# este aqui é o outro lado da conversa.
# Só dígitos, com DDI. Mais de um, separados por vírgula.
OWNER_PHONE=5511999999999,5511888888888

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
# A Shopify descontinuou os custom apps do admin (que davam token fixo).
# Hoje: crie o app no Dev Dashboard, instale na loja, e use Client ID + Secret.
# O código troca esses dois por um token de 24h e renova sozinho.
# Escopos do app: read_orders, read_products, read_inventory, read_reports, read_analytics
SHOPIFY_SHOP=l-f-oficial.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Só se você mantém um custom app legado. Se preenchido, tem precedência.
SHOPIFY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Meta Ads
# ---------------------------------------------------------------------------
# Business Manager -> Usuários do sistema -> token sem expiração, com ads_read.
META_SYSTEM_TOKEN=
# Contas que consolidam, separadas por vírgula. Hoje só a L&F01 gasta.
# Atenção: essa conta estava em IN_GRACE_PERIOD em 13/09/2026.
META_AD_ACCOUNT_IDS=2384690018414844
# Gross-up de imposto: fatura de R$ 32.221,01 com R$ 4.456,28 = 13,8304%.
# Aplica-se só ao valor pago e ao ROAS, e só no Meta.
# Reconferir contra a soma das faturas no fechamento do mês.
META_TAX_FACTOR=1.138304

# ID da conta do WhatsApp Business, para contar mensagens por template.
# Se ficar vazio, `npm run whatsapp-teste` descobre qual é e imprime o valor.
WABA_ID=
# Token separado para o WhatsApp: ele mora no portfólio "L&F Alfaiataria" e os
# anúncios em outro, e token de usuário do sistema não atravessa portfólio.
# Precisa da permissão whatsapp_business_management.
META_WHATSAPP_TOKEN=

# ---------------------------------------------------------------------------
# Google Ads
# ---------------------------------------------------------------------------
# Developer tokens foram descontinuados em 09/09/2026. Hoje o acesso é pedido
# no Google Cloud Console (Basic access sai em minutos) e as requisições levam
# só o OAuth. Passos: criar projeto no Cloud, habilitar a Google Ads API, pedir
# acesso, criar credencial OAuth "App para computador", e rodar:
#   npm run google-oauth
# ID da conta. Pode colar com hífen — é normalizado.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Só se a conta estiver sob uma gerenciadora (MCC): o ID dela. Senão, deixe vazio.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# O Google aposenta versões a cada poucos meses. A v22 saiu em setembro de 2026.
GOOGLE_ADS_API_VERSION=v25
# Só para integrações antigas; hoje é ignorado pela API.
GOOGLE_ADS_DEVELOPER_TOKEN=

# ---------------------------------------------------------------------------
# Metas (Google Sheets via service account)
# ---------------------------------------------------------------------------
# O JSON inteiro da service account, em uma linha só.
# Depois de criar, compartilhe a planilha com o e-mail da conta de serviço.
GOOGLE_SERVICE_ACCOUNT_JSON=
METAS_SPREADSHEET_ID=
METAS_RANGE=Metas!A:B

# ---------------------------------------------------------------------------
# PagBank / PagSeguro
# ---------------------------------------------------------------------------
# Serve para CAIXA, nao para margem: a taxa ja esta fechada em 6,10% cartao /
# 0,99% Pix. Aqui a gente quer saber quanto entrou de verdade na conta e quando
# entra o resto. Cobre so o PagBank — o Mercado Pago e outro gateway.
# Onde pegar: PagBank -> Minha conta -> Vender -> Integracoes -> Token.
PAGBANK_TOKEN=
# Token antigo (ws.pagseguro.uol.com.br), o unico que lista por data e traz
# taxa e liquido: Preferencias > Integracoes > Token de seguranca. E outro
# token, nao o mesmo de cima, e vem junto do e-mail da conta.
PAGBANK_TOKEN_ANTIGO=
PAGBANK_EMAIL=

# ---------------------------------------------------------------------------
# Pagar.me
# ---------------------------------------------------------------------------
# O terceiro meio de pagamento: link mandado no atendimento, com o pedido
# marcado como pago a mao na Shopify. Chave SECRETA (sk_...), em
# Configuracoes > Chaves de API.
PAGARME_TOKEN=

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
# O gateway do Pix da loja. Access Token de PRODUCAO (APP_USR-...), em
# Credenciais > Credenciais de producao.
MERCADOPAGO_TOKEN=

# ---------------------------------------------------------------------------
# MCPs próprios da L&F
# ---------------------------------------------------------------------------
ATENDEPRO_MCP_URL=
ATENDEPRO_TOKEN=
CORTEPRO_MCP_URL=
CORTEPRO_TOKEN=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
TZ=America/Sao_Paulo
# 08:00 no fuso acima — não precisa converter para UTC, o node-cron respeita TZ.
DIGEST_CRON=0 8 * * *
NODE_ENV=production

# --- Holerites: planilha de funcionárias (mesma service account das metas) ---
RH_SPREADSHEET_ID=
RH_RANGE=Funcionarios!A:C

# --- Envio de e-mail (Gmail da empresa com senha de app) ---
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Repasse de eventos do WhatsApp para outro sistema no mesmo número ---
# Destino, segredo que ele exige e os JIDs (grupos) que pertencem a ele.
WEBHOOK_REPASSE_URL=
WEBHOOK_REPASSE_TOKEN=
WEBHOOK_REPASSE_JIDS=
